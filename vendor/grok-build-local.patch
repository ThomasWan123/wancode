+        0 => Err(ModelSelectionError::Unknown(requested.to_owned())),
+        1 => Ok(ResolvedModelSelection {
+            catalog_key: acp::ModelId::new(matches[0].0.clone()),
+            entry: matches[0].1.clone(),
+        }),
